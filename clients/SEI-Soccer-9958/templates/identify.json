{
  "url": "https://api.zetaglobal.net/ver2/sei-soccer-com/subscribers/identify",
  "stageUrl": "https://api.zetaglobal.net/ver2/sei-soccer-com/subscribers/identify",
  "bindUrl": false,
  "requestType": "json",
  "verb": "post",
  "paramsType": "mapped",
  "formatType": "structured",
  "encoding": "UTF-8",
  "ignoreEmpty": true,
  "nullHandling": "omit",
  "required": ["email"],
  "sendEntitlements": false,
  "verifyHost": true,
  "trustAll": false,
  "searchForParamsMapKeyword": true,
  "avoidInParamsMap": ["apikey", "campaignId", "ptk", "stageMode", "isXHR", "displayObjectId", "ngxLocale", "ngx_send_cookies", "ngx_ext_id", "ngx_ext_id_type", "ngx_t_token2", "ngx_e_token1", "ngx_e_token2", "source", "channel", "medium"],
  "header": {
    "Authorization": "Basic REPLACE_WITH_BASE64(api:ZMP_REST_API_KEY)",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "params": {
    "subscriber": {
      "uid": "${entry.uid ?: entry.email}",
      "first_name": "${entry.firstname ?: entry.first_name ?: ''}",
      "last_name": "${entry.lastname ?: entry.last_name ?: ''}",
      "properties": {
        "date_of_birth": "${entry.date_of_birth ?: ''}",
        "email": "${entry.email ?: ''}",
        "pref_center_parent": "${(entry.parent ?: entry.pref_center_parent) ? 'Y' : 'N'}",
        "pref_center_coach_admin": "${(entry.coach_admin ?: entry.pref_center_coach_admin) ? 'Y' : 'N'}",
        "pref_center_player": "${(entry.player ?: entry.pref_center_player) ? 'Y' : 'N'}",
        "pref_center_fan": "${(entry.fan ?: entry.pref_center_fan) ? 'Y' : 'N'}",
        "pref_center_cleats_and_shoes": "${(entry.cleats_and_shoes ?: entry.pref_center_cleats_and_shoes) ? 'Y' : 'N'}",
        "pref_center_fan_jerseys_and_gear": "${(entry.fan_jerseys_and_gear ?: entry.pref_center_fan_jerseys_and_gear) ? 'Y' : 'N'}",
        "pref_center_apparel": "${(entry.apparel ?: entry.pref_center_apparel) ? 'Y' : 'N'}",
        "pref_center_soccer_balls_and_equipment": "${(entry.soccer_balls_and_equipment ?: entry.pref_center_soccer_balls_and_equipment) ? 'Y' : 'N'}",
        "pref_center_goalkeeper": "${(entry.goalkeeper ?: entry.pref_center_goalkeeper) ? 'Y' : 'N'}",
        "pref_center_new_content_and_articles": "${(entry.new_content_and_articles ?: entry.pref_center_new_content_and_articles) ? 'Y' : 'N'}",
        "pref_center_deals_and_special_offers": "${(entry.deals_and_special_offers ?: entry.pref_center_deals_and_special_offers) ? 'Y' : 'N'}"
      },
      "contacts": [
        {
          "contact_type": "email",
          "contact_value": "${entry.email}",
          "subscription_status": "active"
        }
      ],
      "source": "grow"
    }
  }
}
