{
  "url": "https://api.zetaglobal.net/ver2/sei-soccer-com/activities",
  "stageUrl": "https://api.zetaglobal.net/ver2/sei-dev/activities",
  "bindUrl": false,
  "requestType": "json",
  "verb": "post",
  "paramsType": "mapped",
  "formatType": "structured",
  "encoding": "UTF-8",
  "ignoreEmpty": true,
  "nullHandling": "omit",
  "required": ["email"],
  "sendEntitlements": false,
  "verifyHost": true,
  "trustAll": false,
  "logDebug": true,
  "searchForParamsMapKeyword": true,
  "header": {
    "Authorization": "Basic REPLACE_WITH_BASE64(api:ZMP_REST_API_KEY)",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "params": {
    "activity": {
      "identify_person": true,
      "subscriber": {
        "uid": "${entry.email ?: entry.uid}",
        "first_name": "${entry.firstname ?: entry.name_Firstname ?: entry.first_name ?: ''}",
        "last_name": "${entry.lastname ?: entry.name_Lastname ?: entry.last_name ?: ''}",
        "source": "grow",
        "contacts": [
          {
            "contact_type": "email",
            "contact_value": "${entry.email ?: entry.uid}",
            "subscription_status": "active"
          }
        ],
        "properties": {
          "email": "${entry.email ?: ''}"
        }
      },
      "event": "REPLACE_EVENT_NAME",
      "properties": {
        "source": "grow",
        "email": "${entry.email ?: ''}"
      }
    }
  }
}
