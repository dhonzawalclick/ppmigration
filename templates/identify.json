{
  "url": "https://api.zetaglobal.net/ver2/sei-soccer-com/subscribers/identify",
  "stageUrl": "https://api.zetaglobal.net/ver2/sei-dev/subscribers/identify",
  "bindUrl": false,
  "requestType": "json",
  "verb": "post",
  "paramsType": "mapped",
  "formatType": "structured",
  "encoding": "UTF-8",
  "ignoreEmpty": true,
  "nullHandling": "omit",
  "required": ["email"],
  "sendEntitlements": false,
  "verifyHost": true,
  "trustAll": false,
  "logDebug": true,
  "searchForParamsMapKeyword": true,
  "header": {
    "Authorization": "Basic REPLACE_WITH_BASE64(api:ZMP_REST_API_KEY)",
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "params": {
    "subscriber": {
      "uid": "${entry.email ?: entry.uid}",
      "first_name": "${entry.firstname ?: entry.name_Firstname ?: entry.first_name ?: ''}",
      "last_name": "${entry.lastname ?: entry.name_Lastname ?: entry.last_name ?: ''}",
      "source": "grow",
      "contacts": [
        {
          "contact_type": "email",
          "contact_value": "${entry.email ?: entry.uid}",
          "subscription_status": "active"
        }
      ],
      "properties": {
        "first_name": "${entry.firstname ?: entry.name_Firstname ?: entry.first_name ?: ''}",
        "last_name": "${entry.lastname ?: entry.name_Lastname ?: entry.last_name ?: ''}",
        "date_of_birth": "${entry.date_of_birth ?: params.date_of_birth ?: ''}",
        "email": "${entry.email ?: ''}",
        "pref_center_parent": "${((params.I_am_a ?: entry.I_am_a ?: '') as String).contains('parent') ? 'Y' : 'N'}",
        "pref_center_coach_admin": "${((params.I_am_a ?: entry.I_am_a ?: '') as String).contains('coachadmin') ? 'Y' : 'N'}",
        "pref_center_player": "${((params.I_am_a ?: entry.I_am_a ?: '') as String).contains('player') ? 'Y' : 'N'}",
        "pref_center_fan": "${((params.I_am_a ?: entry.I_am_a ?: '') as String).contains('fan') ? 'Y' : 'N'}",
        "pref_center_latest_product_drops": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('latest_product_drops') ? 'Y' : 'N'}",
        "pref_center_cleats_and_shoes": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('cleats_and_shoes') ? 'Y' : 'N'}",
        "pref_center_fan_jerseys_and_gear": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('fan_jerseys_and_gear') ? 'Y' : 'N'}",
        "pref_center_apparel": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('apparel') ? 'Y' : 'N'}",
        "pref_center_soccer_balls_and_equipment": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('soccer_balls_and_equipment') ? 'Y' : 'N'}",
        "pref_center_goalkeeper": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('goalkeeper') ? 'Y' : 'N'}",
        "pref_center_new_content_and_articles": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('new_content_and_articles') ? 'Y' : 'N'}",
        "pref_center_deals_and_special_offers": "${((params.My_preferences ?: entry.My_preferences ?: '') as String).contains('deals_and_special_offers') ? 'Y' : 'N'}"
      }
    }
  }
}
